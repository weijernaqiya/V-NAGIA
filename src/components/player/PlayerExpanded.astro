---
import PlayerProgress from './PlayerProgress.astro';
import PlayerQueue from './PlayerQueue.astro';

interface QueueTrack {
  id: string;
  title: string;
  artist: string;
  available: boolean;
}

interface Props {
  tracks: QueueTrack[];
}

const { tracks } = Astro.props;
---

<section
  class="music-player__expanded"
  data-player-expanded
  aria-label="全站音乐播放器"
  aria-hidden="true"
  inert
>
  <div class="music-player__full-field" aria-hidden="true">
    <i></i><i></i><i></i><i></i>
  </div>

  <header class="music-player__header">
    <div class="music-player__identity">
      <span class="music-player__mini-artwork">
        <img data-player-artwork alt="" hidden />
        <i data-player-artwork-fallback aria-hidden="true">A</i>
      </span>
      <div>
        <p data-player-title>ASYMPTOTE</p>
        <small data-player-artist>V. NAGIA</small>
      </div>
    </div>

    <div class="music-player__window-actions">
      <button type="button" data-player-full-toggle aria-label="切换全屏播放器" aria-pressed="false">
        <span data-player-full-label>全屏</span>
      </button>
      <button class="music-player__close" type="button" data-player-close aria-label="收起音乐播放器">
        <span aria-hidden="true">收起</span>
      </button>
    </div>
  </header>

  <div class="music-player__full-stage">
    <div class="music-player__full-artwork" data-player-full-artwork>
      <img data-player-full-artwork-image alt="" hidden />
      <span data-player-full-artwork-fallback>
        <b>ASYMPTOTE</b>
        <small>MUSIC / NO ARTWORK</small>
      </span>
    </div>
    <div class="music-player__full-copy">
      <p>正在播放 <span data-player-full-format>FLAC</span></p>
      <h2 data-player-full-title>ASYMPTOTE</h2>
      <h3 data-player-full-artist>V. NAGIA</h3>
      <p data-player-full-album>Title Sequence</p>
      <section class="music-player__lyrics" aria-labelledby="player-lyrics-title">
        <h4 id="player-lyrics-title">歌词</h4>
        <p data-player-full-lyrics>此曲目没有附带歌词。</p>
      </section>
    </div>
  </div>

  <div class="music-player__transport" role="group" aria-label="播放控制">
    <button type="button" data-player-shuffle aria-label="开启随机播放" aria-pressed="false">
      <span aria-hidden="true">随机</span>
    </button>
    <button type="button" data-player-previous aria-label="上一首">
      <span aria-hidden="true">‹</span>
    </button>
    <button class="music-player__play" type="button" data-player-playback aria-label="播放">
      <span data-player-playback-icon aria-hidden="true">▶</span>
    </button>
    <button type="button" data-player-next aria-label="下一首">
      <span aria-hidden="true">›</span>
    </button>
    <button type="button" data-player-repeat aria-label="切换循环模式" data-repeat-mode="off">
      <span data-player-repeat-label>循环</span>
    </button>
    <p class="music-player__status" data-player-status aria-live="polite">就绪</p>
  </div>

  <div class="music-player__error-actions" data-player-error-actions hidden>
    <button type="button" data-player-retry>重试</button>
    <button type="button" data-player-skip>跳过</button>
  </div>

  <PlayerProgress />

  <footer class="music-player__footer">
    <button type="button" data-player-mute aria-label="取消静音" aria-pressed="true">
      <span aria-hidden="true">声音</span>
    </button>

    <label class="music-player__volume">
      <span class="visually-hidden">音量</span>
      <input type="range" min="0" max="100" step="1" value="42" data-player-volume />
    </label>

    <button type="button" data-player-queue-toggle aria-label="打开播放队列" aria-expanded="false">
      队列
    </button>
  </footer>

  <PlayerQueue tracks={tracks} />
</section>
