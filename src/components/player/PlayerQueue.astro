---
interface QueueTrack {
  id: string;
  title: string;
  artist: string;
  available: boolean;
}

interface Props {
  tracks: QueueTrack[];
}

const { tracks } = Astro.props;
---

<div class="music-player__queue" data-player-queue aria-label="播放队列" inert>
  <header>
    <p>播放队列 <span data-player-queue-source>手动</span></p>
    <button type="button" data-player-queue-clear>清除其余</button>
  </header>
  <ol>
    {tracks.map((track) => (
      <li data-player-queue-item={track.id}>
        <button
          class="music-player__queue-track"
          type="button"
          data-player-queue-track={track.id}
          aria-label={`播放 ${track.title}`}
          disabled={!track.available}
        >
          <span>{track.title}</span>
          <small>{track.available ? track.artist : '曲目不可用'}</small>
        </button>
        <span class="music-player__queue-order" aria-label={`${track.title} 队列顺序控制`}>
          <button type="button" data-player-queue-up={track.id} aria-label={`向前移动 ${track.title}`}>↑</button>
          <button type="button" data-player-queue-down={track.id} aria-label={`向后移动 ${track.title}`}>↓</button>
          <button type="button" data-player-queue-remove={track.id} aria-label={`从队列移除 ${track.title}`}>×</button>
        </span>
      </li>
    ))}
  </ol>
</div>
