<div class="music-player__progress">
  <input
    type="range"
    min="0"
    max="1000"
    step="1"
    value="0"
    data-player-progress
    aria-label="播放进度"
    disabled
  />
  <div class="music-player__time" aria-hidden="true">
    <time data-player-current-time>00:00</time>
    <time data-player-duration>00:00</time>
  </div>
</div>
