---
import { FRAGMENTS } from '../../config/fragments';
import FragmentPanel from './FragmentPanel.astro';
---

<!--
  五个切面使用轻微重叠的 polygon 共同覆盖整块屏幕。
  WRITING 占据主要面积，其余区域按两个中区、两个小区组织；
  重叠只用于消除 clip-path 抗锯齿产生的细缝，不绘制任何可见边框。
-->
<section
  class="fragment-screen"
  data-fragment-screen
  aria-label="ASYMPTOTE 创作切面"
  aria-hidden="true"
  tabindex="-1"
  inert
>
  <div class="fragment-screen__canvas" data-fragment-canvas>
    {FRAGMENTS.map((fragment) => <FragmentPanel fragment={fragment} />)}
  </div>

  <button
    class="fragment-screen__back"
    type="button"
    data-fragment-back
    aria-label="返回标题画面"
  >
    返回
  </button>

  <button
    class="fragment-screen__theme"
    type="button"
    data-fragment-theme-toggle
    aria-label="切换五分区明暗主题"
    aria-pressed="true"
  >
    <span data-fragment-theme-label>切换至浅色</span>
    <i aria-hidden="true"></i>
  </button>
</section>
