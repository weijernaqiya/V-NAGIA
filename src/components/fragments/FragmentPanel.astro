---
import type { FragmentSection } from '../../config/fragments';

interface Props {
  fragment: FragmentSection;
}

const { fragment } = Astro.props;

/*
 * --fragment-image 已经按正式图片的 cover 模式接好。
 * 当前 image 为 null 时只显示占位色；未来配置图片路径即可替换。
 */
const panelStyle = [
  `--fragment-color-light: ${fragment.color}`,
  `--fragment-color-dark: ${fragment.darkColor}`,
  `--fragment-image: ${fragment.image ? `url("${fragment.image}")` : 'none'}`,
  `--fragment-image-position: ${fragment.imagePosition}`,
].join('; ');
---

<button
  class:list={['fragment-panel', fragment.className]}
  type="button"
  style={panelStyle}
  data-fragment-id={fragment.id}
  data-fragment-href={fragment.href}
  data-fragment-ready={String(fragment.ready)}
  aria-label={`${fragment.titleZh}，${fragment.description}`}
  aria-pressed="false"
>
  <span class="fragment-panel__visual" aria-hidden="true"></span>
  <span
    class:list={[
      'fragment-panel__label',
      `fragment-panel__label--${fragment.labelPosition}`,
    ]}
  >
    <span class="fragment-panel__title" lang="zh-CN">{fragment.titleZh}</span>
    <span class="fragment-panel__description">{fragment.description}</span>
  </span>
</button>
