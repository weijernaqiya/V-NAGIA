---
import { existsSync } from 'node:fs';
import { TITLE_AUDIO } from '../../config/titleTimeline';

const titleAudioFile = new URL('../../../public/audio/title-theme.mp3', import.meta.url);
const titleAudioAvailable = existsSync(titleAudioFile);
---

<!--
  浏览器禁止未经过用户交互直接播放有声媒体。
  音频地址先存放在 data-src 中，只有用户选择 ENTER 后才真正加载；
  因此音乐文件缺失时不会阻止标题动画与静态内容工作。
-->
<div class="sound-controls" data-sound-controls role="group" aria-label="标题音乐控制" inert>
  <audio
    data-title-audio
    data-src={titleAudioAvailable ? TITLE_AUDIO.path : undefined}
    data-track-available={String(titleAudioAvailable)}
    preload="none"
    loop
  ></audio>

  <button
    class="sound-control sound-control--mute"
    type="button"
    data-sound-toggle
    aria-label="开启标题音乐"
    aria-pressed="true"
    disabled
  >
    <span class="sound-control__note" aria-hidden="true">♪</span>
  </button>

  <button
    class="sound-control sound-control--playback"
    type="button"
    data-playback-toggle
    aria-label="暂停标题音乐"
    aria-pressed="false"
    disabled
  >
    <span class="sound-control__playback-icon" aria-hidden="true"></span>
  </button>
</div>
