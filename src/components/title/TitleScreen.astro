---
import FragmentScreen from '../fragments/FragmentScreen.astro';
import { getFragmentTimelineStyle } from '../../config/fragmentTimeline';
import { getTitleTimelineStyle } from '../../config/titleTimeline';
import AsymptoteLogo from './AsymptoteLogo.astro';
import TitleArtwork from './TitleArtwork.astro';

const timelineStyle = [getTitleTimelineStyle(), getFragmentTimelineStyle()].join('; ');
---

<asymptote-title-screen
  class="title-screen"
  data-state="idle"
  data-screen-state="title"
  data-fragment-theme="dark"
  style={timelineStyle}
>
  <main class="title-screen__surface">
    <FragmentScreen />

    <!--
      页面加载后由 title-screen.ts 自动把 data-state 切换为 started。
      Logo、箭头与插画只读取统一 CSS 时间变量，不各自建立计时器。
    -->
    <div class="title-stage">
      <div class="title-composition">
        <div class="title-composition__artwork">
          <div class="title-composition__artwork-motion">
            <TitleArtwork />
          </div>
        </div>

        <div class="title-composition__logo">
          <!--
            切面获得 Focus 后，点击仍然可见的品牌 Logo 可以退出 Focus。
            命中区由 Logo SVG 内部限定为英文标题与箭头，不覆盖右侧插画预留区。
          -->
          <div class="title-composition__logo-motion" data-fragment-focus-reset>
            <AsymptoteLogo />
          </div>
        </div>
      </div>
    </div>

    <div class="continue-prompt-shell">
      <button
        class="continue-prompt"
        type="button"
        data-fragment-enter
        aria-label="进入世界切面"
        disabled
      >
        PRESS / ENTER
      </button>
    </div>

    <p class="title-credit">V. NAGIA <span aria-hidden="true">·</span> 2026 <span aria-hidden="true">—</span></p>
  </main>
</asymptote-title-screen>

<script src="../../scripts/title-screen.ts"></script>
